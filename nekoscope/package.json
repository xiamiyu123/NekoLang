{
  "name": "nekoscope",
  "version": "0.1.0",
  "description": "NekoLang compilation pipeline visualizer",
  "private": true,
  "homepage": "https://github.com/xiamiyu123/NekoLang",
  "author": {
    "name": "xiamiyu123",
    "email": "xiamiyu123@users.noreply.github.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "electron-vite build",
    "pack": "node ./scripts/package.mjs --dir",
    "dist": "node ./scripts/package.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "dev.nekolang.nekoscope",
    "productName": "NekoScope",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${env.NEKOSCOPE_RELEASE_VERSION}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../neko",
        "to": "backend/neko",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../examples",
        "to": "backend/examples",
        "filter": [
          "**/*.neko",
          "**/*.toml",
          "**/*.c",
          "**/*.md"
        ]
      },
      {
        "from": "../runtime",
        "to": "backend/runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "backend/pyproject.toml"
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "uv",
          "uv.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "xiamiyu123 <xiamiyu123@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
