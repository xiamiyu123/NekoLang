; socket_adapter_demo — 项目内 C 网络适配层示例
; 运行前请先启动一个本地 TCP 文本服务。
; README 中提供了可直接复现的 loopback echo 示例。

(import tcp)

(nya socket_adapter_demo
  (nyan ((client pointer) (ok int) (reply string) (host string) (port int) (message string)))
  (paw
    (:= host (argv-string 0))
    (:= port (argv-int 1))
    (:= message (argv-string 2))
    (:= client (neko_tcp_connect host port))
    (:= ok (neko_tcp_send_text client message))
    (meow ok)
    (:= reply (neko_tcp_recv_line client))
    (meow reply)
    (:= ok (neko_tcp_close client))
    (meow ok)))
