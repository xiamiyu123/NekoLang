; NekoLang runtime demo
; Reads the first CLI argument, adds argc, writes the result to a file.
(nya runtime_demo
  (nyan ((count int) (value int) (result int)))
  (paw
    (:= count (argc))
    (:= value (argv-int 0))
    (:= result (+ value count))
    (write-int "runtime_output.txt" result)
    (meow result)))
