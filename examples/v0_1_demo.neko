; NekoLang v0.1 demo
; Computes 1 + 2 + 3 + 4 + 5, then checks whether the result is positive.
(nya v0_1_demo
  (nyan ((n int) (i int) (total int) (flag bool)))
  (paw
    ; 一个简单的加法函数，演示函数定义和调用。
    (nyaa-def add ((a int) (b int)) int
      (return (+ a b)))

    ; 判断整数是否大于 0。
    (nyaa-def positive ((x int)) bool
      (return (> x 0)))

    ; 准备累计 1 到 n 的总和。
    (:= n 5)
    (:= i 1)
    (:= total 0)

    ; 用 while 循环把每一项累加到 total。
    (purr-while (<= i n)
      (paw
        (:= total (add total i))
        (:= i (+ i 1))))

    ; 再用 bool 函数判断最终结果的符号。
    (:= flag (positive total))
    (meow total)
    (meow flag)))
