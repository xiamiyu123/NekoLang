; NekoLang Fibonacci - 斐波那契数列
(program fibonacci
  (var ((a int) (b int) (c int) (n int) (i int)))
  (begin
    (:= a 0)
    (:= b 1)
    (:= n 10)
    (:= i 0)
    (print a)
    (print b)
    (while (< i n)
      (begin
        (:= c (+ a b))
        (:= a b)
        (:= b c)
        (print c)
        (:= i (+ i 1))))))
