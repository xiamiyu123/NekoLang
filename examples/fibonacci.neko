; NekoLang Fibonacci - 斐波那契数列
(nya fibonacci
  (nyan ((a int) (b int) (c int) (n int) (i int)))
  (paw
    (meow a 0)
    (meow b 1)
    (meow n 10)
    (meow i 0)
    (purr a)
    (purr b)
    (purr-while (< i n)
      (paw
        (meow c (+ a b))
        (meow a b)
        (meow b c)
        (purr c)
        (meow i (+ i 1))))))
