; NekoLang Fibonacci - 斐波那契数列
(nya fibonacci
  (nyan ((a int) (b int) (c int) (n int) (i int)))
  (paw
    (:= a 0)
    (:= b 1)
    (:= n 10)
    (:= i 0)
    (meow a)
    (meow b)
    (purr-while (< i n)
      (paw
        (:= c (+ a b))
        (:= a b)
        (:= b c)
        (meow c)
        (:= i (+ i 1))))))
