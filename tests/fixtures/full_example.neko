; Full example - all features
(nya full
  (nyan ((a int) (b int) (result int) (flag int)))
  (paw
    (:= a 10)
    (:= b 3)
    (:= result (+ (* a b) (- a b)))
    (meow result)
    (if (> result 20)
      (:= flag 1)
      (:= flag 0))
    (meow flag)
    (:= a 0)
    (purr-while (< a 5)
      (paw
        (meow a)
        (:= a (+ a 1))))))
