; Full example - all features
(program full
  (var ((a int) (b int) (result int) (flag int)))
  (begin
    (:= a 10)
    (:= b 3)
    (:= result (+ (* a b) (- a b)))
    (print result)
    (if (> result 20)
      (:= flag 1)
      (:= flag 0))
    (print flag)
    (:= a 0)
    (while (< a 5)
      (begin
        (print a)
        (:= a (+ a 1))))))
