; 测试字符串操作
; 运行: uv run neko run test_cases/11_string.neko
(program string_demo
  (var ((s1 string) (s2 string) (len int) (cmp int) (has bool)))
  (begin
    (:= s1 "Hello")
    (:= s2 "World")
    ; 长度
    (:= len (string-length s1))
    (print len)
    ; 拼接通过 int-to-string 等操作间接测试
    (print (int-to-string 42))
    ; 子串
    (print (string-sub s1 0 2))
    ; 取字符
    (print (char-to-string (string-at s1 1)))
    ; 比较
    (:= cmp (string-cmp s1 s2))
    (print cmp)
    ; 包含检查
    (:= has (string-contains s1 "ell"))
    (print has)
    ; 字符串转整数
    (print (string-to-int "123"))
    ; 参数读取字符串
    (print (argv-string 0))))
